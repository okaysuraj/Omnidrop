# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL. Use DATABASE_SSL=true for a Neon connection.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnidrop
DATABASE_SSL=false

# Firebase Admin: use these fields or FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
# Preserve escaped newlines in the private key.
FIREBASE_PRIVATE_KEY="your-private-key-with-escaped-newlines"
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Required for online payments and signed payment webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
